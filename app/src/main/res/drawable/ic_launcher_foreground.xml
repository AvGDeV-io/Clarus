<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

  <!-- Subtle ambient halo: copper warmth -->
  <path
      android:pathData="M 256,116 a 140,140 0 1,0 0.1,0 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="256"
          android:centerY="256"
          android:gradientRadius="140">
        <item android:offset="0.0" android:color="#20B8754B" />
        <item android:offset="1.0" android:color="#00B8754B" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Subtle ambient halo: dusty lavender -->
  <path
      android:pathData="M 280,130 a 110,110 0 1,0 0.1,0 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="280"
          android:centerY="240"
          android:gradientRadius="110">
        <item android:offset="0.0" android:color="#1CAAA0D2" />
        <item android:offset="1.0" android:color="#00AAA0D2" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Outer Arc C: Saffron to Copper to Coral -->
  <path
      android:pathData="M 336,160 A 130,130 0 1,0 336,352"
      android:strokeWidth="32"
      android:strokeLineCap="round"
      android:strokeLineJoin="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:type="linear"
          android:startX="150"
          android:startY="150"
          android:endX="350"
          android:endY="350">
        <item android:offset="0.0" android:color="#D5A24A" />
        <item android:offset="0.5" android:color="#B8754B" />
        <item android:offset="1.0" android:color="#C9786A" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Inner Arc C: Dusty Lavender to Deep Indigo -->
  <path
      android:pathData="M 280,180 A 95,95 0 0,1 280,332"
      android:strokeWidth="22"
      android:strokeLineCap="round"
      android:strokeLineJoin="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:type="linear"
          android:startX="280"
          android:startY="180"
          android:endX="185"
          android:endY="332">
        <item android:offset="0.0" android:color="#E6AAA0D2" />
        <item android:offset="0.6" android:color="#B37B73A8" />
        <item android:offset="1.0" android:color="#8036335F" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Focal Beam Halo -->
  <path
      android:pathData="M 256,236 a 20,20 0 1,0 0.1,0 Z"
      android:fillColor="#30F7F3EC" />

  <!-- Warm Central Focal Beam Point: Warm Ivory -->
  <path
      android:pathData="M 256,244 a 12,12 0 1,0 0.1,0 Z"
      android:fillColor="#F7F3EC"
      android:fillAlpha="0.95" />
</vector>
