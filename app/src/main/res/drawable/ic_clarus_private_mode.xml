<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Subtle ambient glow background disc for private sanctuary -->
    <path
        android:pathData="M12,12m-9.5,0a9.5,9.5 0,1 1,19 0a9.5,9.5 0,1 1,-19 0"
        android:strokeAlpha="0.25"
        android:strokeWidth="0.75">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="12"
                android:centerY="12"
                android:gradientRadius="10"
                android:startColor="#25F59E0B"
                android:endColor="#00131319" />
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="2.5"
                android:endX="12"
                android:endY="21.5">
                <item android:offset="0.0" android:color="#90F59E0B" />
                <item android:offset="1.0" android:color="#30F59E0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer architectural C-aperture arc with Radiant Amber -->
    <path
        android:pathData="M15.5,7.5 A6.5,6.5 0 1,0 15.5,16.5"
        android:strokeWidth="1.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="9"
                android:startY="6"
                android:endX="16"
                android:endY="18">
                <item android:offset="0.0" android:color="#FFF59E0B" />
                <item android:offset="0.6" android:color="#FFD97706" />
                <item android:offset="1.0" android:color="#FFB8754B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner intersecting lens arc with Velvet Violet specular highlight -->
    <path
        android:pathData="M13,8.8 A4.5,4.5 0 0,1 13,15.2"
        android:strokeWidth="1.4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="13"
                android:startY="8"
                android:endX="13"
                android:endY="16">
                <item android:offset="0.0" android:color="#FFAAA0D2" />
                <item android:offset="0.5" android:color="#FFB8754B" />
                <item android:offset="1.0" android:color="#FF92400E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central tactile focal point / specular bead -->
    <path
        android:pathData="M12,12m-1.2,0a1.2,1.2 0,1 1,2.4 0a1.2,1.2 0,1 1,-2.4 0"
        android:fillColor="#FCFAF6" />

</vector>
