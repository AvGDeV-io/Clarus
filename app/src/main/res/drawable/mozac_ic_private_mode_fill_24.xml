<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Clarus Private Mode Fill Icon (24dp): Concentric refractive C-arcs with radiant amber and velvet violet -->
    <!-- Outer Clarus C-arc with radiant amber gradient -->
    <path
        android:pathData="M16.2,6.5 A7.2,7.2 0 1,0 16.2,17.5"
        android:strokeWidth="2.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="5"
                android:endX="17"
                android:endY="19">
                <item android:offset="0.0" android:color="#FFF59E0B" />
                <item android:offset="1.0" android:color="#FFB8754B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner intersecting lens arc with velvet violet -->
    <path
        android:pathData="M13.8,8.2 A4.8,4.8 0 0,1 13.8,15.8"
        android:strokeWidth="1.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="14"
                android:startY="8"
                android:endX="14"
                android:endY="16">
                <item android:offset="0.0" android:color="#FFAAA0D2" />
                <item android:offset="1.0" android:color="#FF8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central specular bead -->
    <path
        android:pathData="M12,12m-1.2,0a1.2,1.2 0,1 1,2.4 0a1.2,1.2 0,1 1,-2.4 0"
        android:fillColor="#FEF3C7" />

</vector>
