<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Porcelain pebble base disc with radiant amber rim -->
    <item
        android:gravity="center"
        android:width="24dp"
        android:height="24dp">
        <shape android:shape="oval">
            <solid android:color="@color/clarus_switch_thumb_checked_fill" />
            <stroke
                android:width="1.5dp"
                android:color="@color/clarus_switch_thumb_checked_stroke" />
        </shape>
    </item>
    <!-- Tactile specular highlight bead -->
    <item
        android:gravity="center"
        android:top="3dp"
        android:left="3dp"
        android:right="12dp"
        android:bottom="12dp">
        <shape android:shape="oval">
            <solid android:color="#B0FFFFFF" />
        </shape>
    </item>
</layer-list>
