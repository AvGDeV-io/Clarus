<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="20"
    android:viewportHeight="20">

    <!-- Obsidian circular badge base with subtle amber outline -->
    <path
        android:pathData="M10,10m-8.5,0a8.5,8.5 0,1 1,17 0a8.5,8.5 0,1 1,-17 0"
        android:fillColor="#16141D"
        android:strokeWidth="1"
        android:strokeColor="#50F59E0B" />

    <!-- Outer Clarus C-arc with radiant amber gradient -->
    <path
        android:pathData="M13.2,6.2 A5.2,5.2 0 1,0 13.2,13.8"
        android:strokeWidth="1.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="7"
                android:startY="5"
                android:endX="14"
                android:endY="15">
                <item android:offset="0.0" android:color="#FFF59E0B" />
                <item android:offset="1.0" android:color="#FFB8754B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner intersecting lens arc with velvet violet -->
    <path
        android:pathData="M11.2,7.2 A3.5,3.5 0 0,1 11.2,12.8"
        android:strokeWidth="1.3"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="11"
                android:startY="7"
                android:endX="11"
                android:endY="13">
                <item android:offset="0.0" android:color="#FFAAA0D2" />
                <item android:offset="1.0" android:color="#FF8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central specular bead -->
    <path
        android:pathData="M10,10m-0.9,0a0.9,0.9 0,1 1,1.8 0a0.9,0.9 0,1 1,-1.8 0"
        android:fillColor="#FEF3C7" />

</vector>
